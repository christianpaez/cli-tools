# Required
NOTION_TOKEN=
PAGE_URL=

# Output path relative to SITE (default SITE=~/personal-website)
# Leave OUT empty to auto-generate: _posts/{DATE}-{slug-from-title}.md
# You can also use placeholders: {date} and {slug}, e.g. OUT=_posts/{date}-my-post.md
OUT=
DATE=
SLUG=

# Image download location and Markdown/front matter path
IMG_DIR=assets/images/notion
IMG_URL_PREFIX=assets/images/notion

# Front matter (matches posts in this project)
LAYOUT=post
TITLE=
AUTHOR=christian
# Multiple categories: comma-separated
CATEGORIES=Book Reviews, Literature
IMAGE=
FEATURED=true
HIDDEN=true
PERMALINK=
